# ── 必填 ──────────────────────────────────────────────
SENSENOVA_API_KEY=你的商汤API密钥
QWEATHER_API_KEY=你的和风天气API密钥

# ── 可选（不填则对应功能降级）──────────────────────────
# 百度地图（线下购衣附近店铺搜索）
BAIDU_MAP_AK=
# 拼多多开放平台（线上购衣商品搜索）
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=
# 阿里云DashScope（配图集AI生图兜底）
DASHSCOPE_API_KEY=

# ── 高级配置（一般不用改）──────────────────────────────
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_VLM_MODEL=sensenova-6.7-flash-lite
SENSENOVA_LLM_MODEL=deepseek-v4-flash
QWEATHER_BASE_URL=https://devapi.qweather.com
APP_HOST=127.0.0.1
APP_PORT=8080
DB_PATH=./data.db
